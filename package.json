{
  "name": "pdf-editor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node tests/editor-browser.mjs",
    "predev": "node scripts/prepare-mupdf.mjs && node scripts/prepare-source.mjs",
    "prebuild": "node scripts/prepare-mupdf.mjs && node scripts/prepare-source.mjs",
    "test:direct-browser": "node tests/direct-browser.mjs"
  },
  "dependencies": {
    "konva": "^10.9.1",
    "mupdf": "^1.28.1",
    "next": "^16.0.0",
    "pdfjs-dist": "^5.4.394",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-konva": "^19.3.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  },
  "license": "AGPL-3.0-or-later"
}
